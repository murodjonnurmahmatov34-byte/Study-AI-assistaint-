# ------------------------------------------------------------------
# StudyAI — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection string (required)
# Used by Drizzle ORM (server-side only — never exposed to the client).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Secret used to sign session cookies (required in production)
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=change-me-to-a-long-random-string

# Session cookie security.
# In production the cookie is Secure (HTTPS-only) by default.
# Set COOKIE_SECURE=false only if your production origin is served over plain HTTP.
# COOKIE_SECURE=true

# ------------------------------------------------------------------
# AI provider (optional — OpenAI-compatible API)
# ------------------------------------------------------------------
# When set, the AI tutor, summarizer and quiz generator use a real LLM.
# When NOT set, StudyAI falls back to a built-in offline engine:
#   - Summarizer works (extractive summarization)
#   - Quizzes work when study material is pasted
#   - The tutor runs in transparent "offline mode"
AI_API_KEY=
# Base URL of any OpenAI-compatible endpoint (default: https://api.openai.com/v1)
AI_BASE_URL=
# Model name (default: gpt-4o-mini)
AI_MODEL=

# ------------------------------------------------------------------
# Outbound email (optional)
# ------------------------------------------------------------------
# Enables real password-reset emails when a provider is wired in.
EMAIL_API_KEY=

# ------------------------------------------------------------------
# App
# ------------------------------------------------------------------
# Public origin, used for SEO metadata / Open Graph URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
